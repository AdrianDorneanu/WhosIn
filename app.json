{
	"expo": {
		"name": "whos-in",
		"slug": "whos-in",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/lock.png",
		"scheme": "whosin",
		"userInterfaceStyle": "automatic",
		"ios": {
			"icon": "./assets/expo.icon",
			"bundleIdentifier": "com.paxxa.whos-in"
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./assets/images/lock.png"
			},
			"predictiveBackGestureEnabled": false
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/lock.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#208AEF",
					"android": {
						"image": "./assets/images/lock.png",
						"imageWidth": 76
					}
				}
			],
			"expo-secure-store",
			"expo-font",
			"expo-image",
			"expo-status-bar",
			"expo-web-browser"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		}
	}
}
